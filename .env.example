# Global Environment Variables Example

# --- Backend ---
PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_app_db?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT Auth (RS256 keys or HS256 secret)
JWT_SECRET="your_jwt_secret_at_least_32_chars"
# For RS256, use:
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."

# Auth Specific
SUPER_ADMIN_INVITE_CODE="ERP-ADMIN-2026"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="ERP System <your-email@gmail.com>"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth / Auth.js
AUTH_SECRET="use-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OAuth
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
