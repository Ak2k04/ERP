# Global Environment Variables Example
# Copy to .env in backend and .env.local in frontend as needed

# Backend
BACKEND_PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_app_db?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change_me"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
AUTH_SECRET="change_me"
AUTH_GOOGLE_ID="change_me"
AUTH_GOOGLE_SECRET="change_me"
