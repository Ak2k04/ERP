# Backend Environment Variables
PORT=3001
NODE_ENV=development

# Database (Prisma)
# Replace with your actual credentials if different from docker-compose defaults
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_app_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="your_jwt_secret_at_least_32_chars_long"

# Logging
LOG_LEVEL=info
